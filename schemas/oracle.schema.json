{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluator-only oracle map",
  "type": "object",
  "patternProperties": {
    "^[CTRIKL][0-9]{2}$": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "code",
            "tool",
            "json",
            "text",
            "constraints"
          ]
        },
        "runtime": {
          "enum": [
            "python",
            "typescript",
            "sql"
          ]
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "input",
              "expected"
            ]
          }
        },
        "expected": {},
        "checks": {
          "type": "object"
        },
        "reference": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "arguments",
                "result"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
